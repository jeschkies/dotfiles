#!/usr/bin/env bash
#
# bootstrap installs things.

cd "$(dirname "$0")/.."
DOTFILES_ROOT=$(pwd -P)

set -e

echo ''

info () {
  printf "\r  [ \033[00;34m..\033[0m ] $1\n"
}

user () {
  printf "\r  [ \033[0;33m??\033[0m ] $1\n"
}

success () {
  printf "\r\033[2K  [ \033[00;32mOK\033[0m ] $1\n"
}

fail () {
  printf "\r\033[2K  [\033[0;31mFAIL\033[0m] $1\n"
  echo ''
  exit
}

setup_gitconfig () {
  if ! [ -f git/gitconfig.local.symlink ]
  then
    info 'setup gitconfig'

    git_credential='cache'
    if [ "$(uname -s)" == "Darwin" ]
    then
      git_credential='osxkeychain'
    fi

    user ' - What is your github author name?'
    read -e git_authorname
    user ' - What is your github author email?'
    read -e git_authoremail

    sed -e "s/AUTHORNAME/$git_authorname/g" -e "s/AUTHOREMAIL/$git_authoremail/g" -e "s/GIT_CREDENTIAL_HELPER/$git_credential/g" git/gitconfig.local.symlink.example > git/gitconfig.local.symlink

    success 'gitconfig'
  fi
}


stow_package () {
  local pkg="$1"
  local stow_opts=()
  local dry_run_output

  if dry_run_output=$(stow -n "${stow_opts[@]}" "$pkg" 2>&1)
  then
    stow "${stow_opts[@]}" "$pkg"
    return
  fi

  # Cover every conflict message stow can emit (see Stow.pm). Missing one means
  # falling through to the "could not be parsed" branch below instead of
  # offering to override.
  local conflicts
  conflicts=$(echo "$dry_run_output" | sed -n \
    -e 's/.*over existing target \(.*\) since.*/\1/p' \
    -e 's/.*over existing directory target \(.*\)/\1/p' \
    -e 's/.*over existing non-directory target \(.*\)/\1/p' \
    -e 's/.*existing target is not owned by stow: \(.*\)/\1/p' \
    -e 's/.*existing target is neither a link nor a directory: \(.*\)/\1/p' \
    -e 's/.*existing target is stowed to a different package: \(.*\) => .*/\1/p' \
    | sort -u)

  if [ -z "$conflicts" ]
  then
    echo "$dry_run_output"
    fail "stow failed for '$pkg' and the conflict could not be parsed; resolve manually"
  fi

  user "'$pkg' conflicts with existing files:"
  echo "$conflicts" | sed "s|^|        $HOME/|"
  user " - Override (delete the files above) and stow '$pkg', or abort? [o/A]"
  read -e -r answer

  if [[ "$answer" =~ ^[Oo]$ ]]
  then
    while IFS= read -r rel_path
    do
      rm -rf "$HOME/$rel_path"
    done <<< "$conflicts"

    stow "${stow_opts[@]}" "$pkg"
    success "stowed '$pkg' (overrode conflicting files)"
  else
    fail "aborted: '$pkg' has conflicting files"
  fi
}

install_dotfiles () {
  info 'installing dotfiles'

  pushd "$HOME/.dotfiles"
  for pkg in $(ls -d */ | rg -v "bootstrap|script|system|bin|functions|git")
  do
    pkg="${pkg%/}"

    user "Configure '$pkg'? [Y/n]"
    read -e -r answer

    if [[ "$answer" =~ ^[Nn]$ ]]
    then
      info "skipped '$pkg'"
      continue
    fi

    stow_package "$pkg"
  done
  popd
}

load_brew_shellenv () {
  # On a fresh install brew is not on PATH yet, so find it by prefix.
  local prefix
  for prefix in /opt/homebrew /usr/local
  do
    if [ -x "$prefix/bin/brew" ]
    then
      eval "$("$prefix/bin/brew" shellenv)"
      return
    fi
  done

  fail "homebrew was installed but no brew executable was found"
}

install_dependencies () {
  info 'setting macOS defaults'
  "$DOTFILES_ROOT/macos/set-defaults.sh"

  info 'installing homebrew'
  "$DOTFILES_ROOT/homebrew/install.sh"
  load_brew_shellenv

  info 'updating homebrew'
  brew update

  info 'running installers'
  "$DOTFILES_ROOT/script/install"

  success 'dependencies installed'
}

setup_gitconfig
install_dotfiles

# If we're on a Mac, let's install and setup homebrew.
if [ "$(uname -s)" == "Darwin" ]
then
  install_dependencies
fi

echo ''
echo '  All installed!'
